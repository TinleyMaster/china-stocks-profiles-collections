# 数据库连接（推荐 PostgreSQL，JSON 字段 + 数组原生支持）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=china_stocks
DB_USER=postgres
DB_PASSWORD=your_password

# 调度配置
SCHEDULER_ENABLED=true
TIMEZONE=Asia/Shanghai

# 股票池配置（逗号分隔，留空表示全 A 股）
WATCHLIST_CODES=
# 优先采集的行业（申万一级，空=全部）
PRIORITY_INDUSTRIES=

# 采集并发
MAX_WORKERS=4

# 邮件告警（失败通知，可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
